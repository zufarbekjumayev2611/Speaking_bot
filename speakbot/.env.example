# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring. .env ni GitHub'ga YUKLAMANG.
BOT_TOKEN=            # @BotFather bergan token
GROQ_API_KEY=         # console.groq.com - ovozni matnga aylantirish (va standart baholash) uchun
WEBAPP_URL=           # Render'da bo'sh qoldirish mumkin (RENDER_EXTERNAL_URL ishlatiladi); lokalda tunnel manzili
ADMIN_IDS=            # vergul bilan: 111111111,222222222
EXAM_LANGUAGE=tr      # tr (turk tili) yoki en (ingliz tili)
GRADER_PROVIDER=groq  # groq yoki claude
# ANTHROPIC_API_KEY=  # faqat GRADER_PROVIDER=claude bo'lsa kerak
# RATERS=1            # 1-3, ko'proq = barqarorroq, lekin qimmatroq
# DB_PATH=speakbot.db # Render'da disk bilan: /var/data/speakbot.db
# PREMIUM_ENABLED=1   # 0 = premium tizimi o'chiq, hamma uchun cheklovsiz
# FREE_MONTHLY_LIMIT=5  # bepul foydalanuvchi uchun oyiga nechta tekshiruv (speaking + writing)
